NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/travel_guide?schema=public

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ISSUER=travel-guide-api
JWT_AUDIENCE=travel-guide-clients
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
APPLE_CLIENT_ID=com.example.travel-guide
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_KEY_ID=YOUR_KEY_ID
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----"
OAUTH_ALLOWED_REDIRECT_URIS=http://localhost:3000/auth/callback,travelguide://auth/callback

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60
AUTH_THROTTLE_TTL_MS=60000
AUTH_THROTTLE_LIMIT=5
CONTENT_THROTTLE_TTL_MS=60000
CONTENT_THROTTLE_LIMIT=20
TRAVEL_INGESTION_THROTTLE_TTL_MS=300000
TRAVEL_INGESTION_THROTTLE_LIMIT=1
TRAVEL_INGESTION_MAX_TREND_KEYWORDS=10
TRAVEL_INGESTION_MAX_CANDIDATE_URLS=40
TRAVEL_INGESTION_MAX_POSTS=20
TRAVEL_INGESTION_MAX_PLACES=10
TRAVEL_INGESTION_MAX_PROVINCE_QUERIES=5
TRAVEL_INGESTION_SEARCH_PAGES=2
TRAVEL_INGESTION_SEARCH_RESULTS_PER_PAGE=10
TRAVEL_INGESTION_POLL_INTERVAL_MS=3000
TRAVEL_INGESTION_LEASE_DURATION_MS=300000
TRAVEL_INGESTION_HEARTBEAT_INTERVAL_MS=30000
TRAVEL_INGESTION_MAX_ATTEMPTS=3

REQUIRE_MODERATION=true

# Required only when calling the admin travel-content ingestion endpoint.
OXY_WSA_USERNAME=your-oxylabs-web-scraper-username
OXY_WSA_PASSWORD=your-oxylabs-web-scraper-password
OXY_WSA_TIMEOUT_MS=120000

ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Optional; all three values are required when running `npm run admin:bootstrap`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_DISPLAY_NAME=Travel Guide Admin
